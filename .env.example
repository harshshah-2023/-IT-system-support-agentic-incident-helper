# Copy to .env. Never commit .env. Every value below is read by incident_helper.config.Settings.

# --- Provider credentials ------------------------------------------------------------------
# Comma-separate several keys to enable rotation, e.g. OPENAI_API_KEY=sk-a,sk-b
OPENAI_API_KEY=
# Used ONLY by the fallback model. Set it to the same real key: the Task 7 live defence corrupts
# OPENAI_API_KEY and the fallback must keep working.
OPENAI_FALLBACK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Model profiles (provider:model, resolved by init_chat_model) ---------------------------
FAST_MODEL=openai:gpt-4o-mini
REASONING_MODEL=openai:gpt-4o
FALLBACK_MODEL=openai:gpt-4o-mini
JUDGE_MODEL=openai:gpt-4o-mini

# --- LangSmith (Task 6) ---------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=incident-helper

# --- RAG ------------------------------------------------------------------------------------
# Swap the reviewer's document in here (.pdf, .md or .html) and run: incident index
RUNBOOK_PATH=data/runbook/larkspur_runbook.pdf
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_SCORE_THRESHOLD=0.62
RAG_TOP_K=8

# --- Gateway --------------------------------------------------------------------------------
CACHE_TTL_SECONDS=900
SEMANTIC_CACHE_THRESHOLD=0.93
# Fault injection for the fallback demonstration: none | rate_limit | auth
GATEWAY_CHAOS=none

# --- Authorisation --------------------------------------------------------------------------
ONCALL_ENGINEERS=asha.menon,daniel.okafor,mei.tanaka
